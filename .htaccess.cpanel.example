# =============================================================================
# cPanel / Shared Hosting — Root .htaccess
# =============================================================================
#
# ASSUMED STRUCTURE
# ─────────────────
# Domain document root:  /home/cpaneluser/bucket.digitalku.com/
#
# /home/cpaneluser/bucket.digitalku.com/
# ├── .htaccess          ← this file (rename from .htaccess.cpanel.example)
# ├── app/
# ├── public/
# │   ├── .htaccess      ← Laravel default, leave untouched
# │   └── index.php
# ├── .env
# └── ...
#
# HOW TO DEPLOY
# ─────────────
# 1. Upload the full project to /home/cpaneluser/bucket.digitalku.com/
# 2. Rename this file to .htaccess (place it at the document root)
# 3. Set APP_URL=https://bucket.digitalku.com in .env
# 4. Run via SSH or cPanel Terminal:
#      php artisan storage:link
#      php artisan config:cache
#      php artisan route:cache
# 5. Make sure these directories are writable (755):
#      storage/
#      bootstrap/cache/
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forward all requests to Laravel's public/ directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
